            "incoming": {
                "mode": "steal",
                "http_filter": {
                    "path_filter": "^/(?!api|federation\\.manifest\\.json|phobos\\.manifest\\.json).*"
                }
            }
        },
        "fs": "local",
        "env": true
    }
